/* =========================================================
   SILICON BRAND NEO-BRUTALIST QSS
   ========================================================= */

/* --- GLOBAL BASE --- */
QWidget {
    /* --background */
    background-color: SILICON_BACKGROUND;
    color: SILICON_INK;
    font-family: "Quicksand";
    font-size: 14px;
}

/* Ensure main containers don't double-draw backgrounds */
QMainWindow, QDialog, QStackedWidget {
    background-color: SILICON_BACKGROUND;
}

/* --- TYPOGRAPHY --- */
/* Apply to specific labels via objectName (e.g., #headingLabel)
   or dynamic properties (e.g., [heading="true"]) */
QLabel[heading="true"], QLabel#titleLabel {
    font-family: "Chango";
    font-size: 24px;
    letter-spacing: 1px;
}

QTextEdit.mono, QPlainTextEdit, QLabel.mono {
    font-family: "NovaMono";
}

/* --- SILICON CARD --- */
/* Apply to QFrames, QGroupBoxes, or QWidgets acting as cards */
QFrame#siliconCard, QGroupBox.silicon-card {
    /* --card */
    background-color: SILICON_SURFACE_RAISED;
    border-radius: 20px;

    /* FAKING THE BOX-SHADOW: 6px 6px 0 0 */
    border-top: 2px solid SILICON_INK;
    border-left: 2px solid SILICON_INK;
    border-right: 6px solid SILICON_INK;
    border-bottom: 6px solid SILICON_INK;
}

/* --- SILICON BUTTON --- */
QPushButton {
    background-color: SILICON_SURFACE;
    color: SILICON_INK;
    font-family: "Quicksand";
    font-weight: bold;
    border-radius: 12px;
    padding: 10px 18px;

    /* FAKING THE BOX-SHADOW: 4px 4px 0 0 */
    border-top: 2px solid SILICON_INK;
    border-left: 2px solid SILICON_INK;
    border-right: 4px solid SILICON_INK;
    border-bottom: 4px solid SILICON_INK;
}

QPushButton:hover {
    /* Silicon Green pop on hover */
    background-color: SILICON_GREEN;
}

QPushButton:pressed {
    /* Faking the transform/translate push effect */
    border: 2px solid SILICON_INK;

    /* Push text/icon down/right */
    padding-top: 12px;
    padding-left: 20px;
    padding-right: 16px;
    padding-bottom: 8px;
}

/* --- INPUTS / FORMS --- */
QLineEdit, QComboBox, QSpinBox, QTextEdit, QPlainTextEdit {
    background-color: SILICON_SURFACE;
    color: SILICON_INK;
    border: 2px solid SILICON_INK;
    border-radius: 8px;
    padding: 6px 10px;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QTextEdit:focus, QPlainTextEdit:focus {
    /* Ring equivalent */
    border: 2px solid SILICON_MAGENTA;
}

/* --- CONTEXT MENUS --- */
QMenu {
    background-color: SILICON_SURFACE_RAISED;
    /* Faking the drop shadow on menus */
    border-top: 2px solid SILICON_INK;
    border-left: 2px solid SILICON_INK;
    border-right: 4px solid SILICON_INK;
    border-bottom: 4px solid SILICON_INK;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    background-color: transparent;
    color: SILICON_INK;
    padding: 8px 28px 8px 16px;
    font-weight: 600;
    border-radius: 6px;
    margin: 2px;
}

QMenu::item:selected {
    /* Hover state for context menus */
    background-color: SILICON_ORANGE;
    color: SILICON_INK;
}

QMenu::separator {
    height: 2px;
    background-color: SILICON_INK;
    margin: 4px 8px;
}

QMenu::item:disabled {
    color: SILICON_DISABLED; /* Grayed out text */
    background-color: transparent;
}

/* --- SCROLLBARS --- */

/* Vertical Scrollbar */
QScrollBar:vertical {
    background-color: transparent;
    border-left: 2px solid SILICON_INK;
    width: 18px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: SILICON_SURFACE;
    border: 2px solid SILICON_INK;
    border-radius: 7px;
    min-height: 30px;
    margin: 2px 3px;
}

QScrollBar::handle:vertical:hover {
    background-color: SILICON_BLUE;
}

/* Horizontal Scrollbar */
QScrollBar:horizontal {
    background-color: transparent;
    border-top: 2px solid SILICON_INK;
    height: 18px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: SILICON_SURFACE;
    border: 2px solid SILICON_INK;
    border-radius: 7px;
    min-width: 30px;
    margin: 3px 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: SILICON_BLUE;
}

/* Hide OS arrows for a cleaner, modern look */
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
    height: 0px;
    border: none;
    background: none;
}

/* Removes the dark background when clicking the track */
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}
